// Client ID loại "iOS" trên Google Cloud (bundle id vn.vimathuat.magicWallet), VIẾT NGƯỢC.
// Ví dụ client 123-abc.apps.googleusercontent.com → com.googleusercontent.apps.123-abc
// Client ID xuôi truyền lúc build: --dart-define=GOOGLE_IOS_CLIENT_ID=123-abc.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_PREFIX
